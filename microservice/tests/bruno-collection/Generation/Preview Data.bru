meta {
  name: Preview Data
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/projects/{{projectId}}/preview
  body: none
  auth: none
}

vars:pre-request {
  projectId: 1
}

tests {
  test("Status code should be 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response should contain project information", function() {
    expect(res.body).to.have.property('projectId');
    expect(res.body).to.have.property('projectName');
  });

  test("Response should contain generated data", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });

  test("Data should contain entity records", function() {
    if (res.body.data && res.body.data.length > 0) {
      expect(res.body.data[0]).to.have.property('entityName');
      expect(res.body.data[0]).to.have.property('records');
      expect(res.body.data[0].records).to.be.an('array');
    }
  });
}
