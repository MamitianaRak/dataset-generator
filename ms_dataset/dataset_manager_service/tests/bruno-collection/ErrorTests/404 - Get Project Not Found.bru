meta {
  name: 404 - Get Project Not Found
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/projects/999999
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8081/api
}

tests {
  test("Status code should be 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Error response should have correct structure (timestamp, status, error, message, path)", function() {
    expect(res.body).to.have.property('timestamp');
    expect(res.body).to.have.property('status');
    expect(res.body).to.have.property('error');
    expect(res.body).to.have.property('message');
    expect(res.body).to.have.property('path');
  });

  test("Error status in body should be 404", function() {
    expect(res.body.status).to.equal(404);
  });

  test("Error field should indicate Not Found", function() {
    expect(res.body.error).to.equal('Not Found');
  });

  test("Message should mention the project ID", function() {
    expect(res.body.message).to.include('999999');
  });
}
