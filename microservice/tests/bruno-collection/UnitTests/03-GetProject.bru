meta {
  name: 3 - Get Project
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/projects/{{unit_project_id}}
  body: none
  auth: none
}

tests {
  test("Status code should be 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response should contain project details", function() {
    expect(res.body).to.have.property('id');
    expect(res.body).to.have.property('name');
    expect(res.body).to.have.property('dateCreated');
  });

  test("Project ID should be a number", function() {
    expect(res.body.id).to.be.a('number');
  });

  test("Project name should be a string", function() {
    expect(res.body.name).to.be.a('string');
  });
}
