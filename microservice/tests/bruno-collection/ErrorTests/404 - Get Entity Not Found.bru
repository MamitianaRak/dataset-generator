meta {
  name: 404 - Get Entity Not Found
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/entities/999999
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8081/api
}

tests {
  test("Status code should be 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Response should contain error information", function() {
    expect(res.body).to.be.an('object');
  });

  test("Should not return entity data", function() {
    expect(res.status).to.not.equal(200);
  });
}
