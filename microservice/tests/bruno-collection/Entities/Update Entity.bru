meta {
  name: Update Entity
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/entities/{{entityId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "UpdatedUser",
    "quantity": 200,
    "attributes": [
      {
        "name": "id",
        "type": {
          "typeClass": "IntegerType"
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "SequentialGenerator",
          "start": 1,
          "step": 1
        }
      },
      {
        "name": "age",
        "type": {
          "typeClass": "IntegerType"
        },
        "constraints": [
          {
            "constraintClass": "MinMaxConstraint",
            "min": 18,
            "max": 80
          }
        ],
        "quantity": 1,
        "generator": {
          "generatorClass": "RandomGenerator"
        }
      },
      {
        "name": "email",
        "type": {
          "typeClass": "StringType",
          "maxLength": 150
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "RandomGenerator"
        }
      },
      {
        "name": "status",
        "type": {
          "typeClass": "EnumType",
          "values": ["active", "inactive", "pending"]
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "EmailGenerator"
        }
      }
    ],
    "subEntities": []
  }
}

vars:pre-request {
  baseUrl: http://localhost:8081/api
  entityId: 1
}
