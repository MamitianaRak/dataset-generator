meta {
  name: 6 - Create Entity
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/entities
  body: json
  auth: none
}

body:json {
  {
    "name": "UnitTestEntity",
    "quantity": 10,
    "attributes": [
      {
        "name": "id",
        "type": {
          "typeClass": "IntegerType"
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "SequentialGenerator",
          "start": 1,
          "step": 1
        }
      },
      {
        "name": "name",
        "type": {
          "typeClass": "StringType",
          "maxLength": 50
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "FakerGenerator",
          "locale": "fr"
        }
      }
    ],
    "subEntities": []
  }
}

tests {
  test("Status code should be 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("Response should contain entity ID", function() {
    expect(res.body).to.have.property('id');
    expect(res.body.id).to.be.a('number');
  });

  test("Response should contain entity name", function() {
    expect(res.body).to.have.property('name');
    expect(res.body.name).to.equal('UnitTestEntity');
  });

  test("Response should contain attributes array", function() {
    expect(res.body).to.have.property('attributes');
    expect(res.body.attributes).to.be.an('array');
  });

  test("Entity quantity should match", function() {
    expect(res.body.quantity).to.equal(10);
  });
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("unit_entity_id", res.body.id);
  }
}
