meta {
  name: 03 - Update Entity
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/entities/{{current_entity_id}}
  body: json
  auth: none
}

body:json {
  {
    "name": "User",
    "quantity": 10,
    "attributes": [
      {
        "name": "id",
        "type": {
          "typeClass": "IntegerType"
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "SequentialGenerator",
          "start": 1,
          "step": 1
        }
      },
      {
        "name": "name",
        "type": {
          "typeClass": "StringType",
          "maxLength": 100
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "RandomGenerator"
        }
      },
      {
        "name": "age",
        "type": {
          "typeClass": "IntegerType"
        },
        "constraints": [
          {
            "constraintClass": "MinMaxConstraint",
            "min": 18,
            "max": 65
          }
        ],
        "quantity": 1,
        "generator": {
          "generatorClass": "RandomGenerator"
        }
      },
      {
        "name": "email",
        "type": {
          "typeClass": "StringType",
          "maxLength": 255
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "EmailGenerator"
        }
      },
      {
        "name": "isActive",
        "type": {
          "typeClass": "BooleanType"
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "RandomGenerator"
        }
      }
    ],
    "subEntities": []
  }
}

tests {
  test("Status code should be 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response should contain updated entity", function() {
    expect(res.body).to.have.property('id');
    expect(res.body.id).to.equal(bru.getEnvVar("current_entity_id"));
  });

  test("Entity should have 5 attributes now", function() {
    expect(res.body.attributes).to.be.an('array');
    expect(res.body.attributes.length).to.equal(5);
  });

  test("New attribute isActive should exist", function() {
    const isActiveAttr = res.body.attributes.find(attr => attr.name === 'isActive');
    expect(isActiveAttr).to.not.be.undefined;
  });
}
