meta {
  name: 4 - Preview Data
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/projects/{{current_project_id}}/preview
  body: none
  auth: none
}

tests {
  test("Status code should be 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  const body = res.getBody();

 test("Status code should be 200 OK", function () {
   expect(res.getStatus()).to.equal(200);
 });

 test("Response should contain project ID", function () {
   expect(body).to.have.property("projectId");
 });

 test("Response should contain project name", function () {
   expect(body).to.have.property("projectName");
   // adapte la valeur si ton body CreateProject envoie un autre nom
   expect(body.projectName).to.equal(bru.getVar("projectName"));
 });

 test("Response should contain generated data array", function () {
   expect(body).to.have.property("data");
   expect(body.data).to.be.an("array");
 });

 test("Data should contain entity with records", function () {
   expect(body.data.length).to.be.greaterThan(0);
   expect(body.data[0]).to.have.property("records");
 });

 test("Entity should have 25 records (updated quantity)", function () {
   expect(body.data[0].records.length).to.equal(25);
 });

 test("Records should have the expected attributes", function () {
   const record = body.data[0].records[0];
   expect(record).to.have.property("fields");
   expect(record.fields).to.have.property("id");
   expect(record.fields).to.have.property("fullName");
   expect(record.fields).to.have.property("isActive");
   expect(record.fields).to.have.property("age");
   expect(record.fields).to.have.property("email");
 });

}
