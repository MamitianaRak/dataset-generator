meta {
  name: 400 - Create Entity Invalid Constraint (min > max)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/entities
  body: json
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8081/api
  projectId: 1
}

body:json {
  {
    "name": "InvalidEntity",
    "quantity": 10,
    "attributes": [
      {
        "name": "invalidAge",
        "quantity": 1,
        "type": {
          "type": "IntegerType"
        },
        "constraints": [
          {
            "type": "MinMaxConstraint",
            "min": 90.0,
            "max": 18.0
          }
        ],
        "generator": {
          "type": "FakerGenerator"
        }
      }
    ]
  }
}

tests {
  test("Status code should be 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Response should indicate constraint validation error", function() {
    expect(res.body).to.be.an('object');
  });

  test("Should not allow min greater than max", function() {
    expect(res.status).to.not.equal(201);
  });
}
