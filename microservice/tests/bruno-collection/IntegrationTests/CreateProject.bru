meta {
  name: 1 - Create Project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: none
}

body:json {
  {
    "name": "Project Test"
  }
}


tests {
  test("Status code should be 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("Response should contain project ID", function() {
    expect(res.body).to.have.property('id');
    expect(res.body.id).to.be.a('number');
  });

  test("Response should contain project name", function() {
    expect(res.body).to.have.property('name');
    expect(res.body.name).to.include('Integration Test Project');
  });

  test("Response should have dateCreated", function() {
    expect(res.body).to.have.property('dateCreated');
  });
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("current_project_id", res.body.id);
    console.log("Project created with ID: " + res.body.id);
  }
}
