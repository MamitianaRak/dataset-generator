meta {
  name: 2 - Add Entity
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/projects/{{current_project_id}}/entities
  body: json
  auth: none
}

body:json {
  {
    "name": "Customer",
    "quantity": 10,
    "attributes": [
      {
        "name": "id",
        "type": {
          "typeClass": "IntegerType"
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "SequentialGenerator",
          "start": 1,
          "step": 1
        }
      },
      {
        "name": "firstName",
        "type": {
          "typeClass": "StringType",
          "maxLength": 50
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "RandomGenerator"
        }
      },
      {
        "name": "age",
        "type": {
          "typeClass": "IntegerType"
        },
        "constraints": [
          {
            "constraintClass": "MinMaxConstraint",
            "min": 18,
            "max": 80
          }
        ],
        "quantity": 1,
        "generator": {
          "generatorClass": "RandomGenerator"
        }
      },
      {
        "name": "email",
        "type": {
          "typeClass": "StringType",
          "maxLength": 100
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "EmailGenerator"
        }
      }
    ],
    "subEntities": []
  }
}

tests {
  test("Status code should be 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("Response should contain entity ID", function() {
    expect(res.body).to.have.property('id');
    expect(res.body.id).to.be.a('number');
  });

  test("Response should contain entity name", function() {
    expect(res.body).to.have.property('name');
    expect(res.body.name).to.equal('Customer');
  });

  test("Response should contain attributes", function() {
    expect(res.body).to.have.property('attributes');
    expect(res.body.attributes).to.be.an('array');
    expect(res.body.attributes.length).to.equal(4);
  });

  test("Entity quantity should be 10", function() {
    expect(res.body.quantity).to.equal(10);
  });
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("current_entity_id", res.body.id);
    console.log("Entity created with ID: " + res.body.id);
  }
}
