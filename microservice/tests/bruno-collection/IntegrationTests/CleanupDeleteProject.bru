meta {
  name: 6 - Cleanup Delete Project
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/projects/{{current_project_id}}
  body: none
  auth: none
}

tests {
  test("Status code should be 204 No Content", function() {
    expect(res.status).to.equal(204);
  });
}

script:post-response {
  bru.setEnvVar("current_project_id", "");
  bru.setEnvVar("current_entity_id", "");
  console.log("Cleanup completed - Project and Entity IDs cleared");
}
