meta {
  name: 404 - Get Project Not Found
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/projects/999999
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8081/api
}

tests {
  test("Status code should be 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Response should contain error message", function() {
    expect(res.body).to.be.an('object');
  });
}
