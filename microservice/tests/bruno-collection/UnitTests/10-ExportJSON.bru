meta {
  name: 13 - Export XML
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/projects/{{unit_project_id}}/export?format=xml
  body: none
  auth: none
}

tests {
  test("Status code should be 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Content-Type should be application/xml", function() {
    expect(res.headers['content-type']).to.include('application/xml');
  });

  test("Content-Disposition should indicate file attachment", function() {
    expect(res.headers['content-disposition']).to.include('attachment');
    expect(res.headers['content-disposition']).to.include('.xml');
  });

  test("Response body should exist", function() {
    expect(res.body).to.exist;
  });
}
