meta {
  name: 11 - Preview Data
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/projects/{{projectId}}/preview
  body: none
  auth: none
}

tests {
  test("Status code should be 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response should contain project ID", function() {
    expect(res.body).to.have.property('projectId');
  });

  test("Response should contain project name", function() {
    expect(res.body).to.have.property('projectName');
  });

  test("Response should contain data array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });

  test("Data items should have entityName and records", function() {
    if (res.body.data && res.body.data.length > 0) {
      expect(res.body.data[0]).to.have.property('entityName');
      expect(res.body.data[0]).to.have.property('records');
    }
  });
}
