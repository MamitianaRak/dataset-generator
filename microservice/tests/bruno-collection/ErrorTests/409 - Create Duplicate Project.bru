meta {
  name: 409 - Create Duplicate Project
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: none
}

body:json {
  {
    "name": "Project Test"
  }
}

tests {
  test("Status code should be 409 Conflict", function() {
    expect(res.status).to.equal(409);
  });

  test("Error response should have correct structure", function() {
    expect(res.body).to.have.property('status');
    expect(res.body).to.have.property('error');
    expect(res.body).to.have.property('message');
  });

  test("Error should indicate conflict", function() {
    expect(res.body.error).to.equal('Conflict');
  });
}
