meta {
  name: 400 - Create Entity Unknown Type
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/entities
  body: json
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8081/api
  projectId: 1
}

body:json {
  {
    "name": "EntityWithUnknownType",
    "quantity": 10,
    "attributes": [
      {
        "name": "unknownField",
        "quantity": 1,
        "type": {
          "type": "UnknownType"
        },
        "constraints": [],
        "generator": {
          "type": "FakerGenerator"
        }
      }
    ]
  }
}

tests {
  test("Status code should be 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Error response should have correct structure (timestamp, status, error, message, path)", function() {
    expect(res.body).to.have.property('timestamp');
    expect(res.body).to.have.property('status');
    expect(res.body).to.have.property('error');
    expect(res.body).to.have.property('message');
    expect(res.body).to.have.property('path');
  });

  test("Error status in body should be 400", function() {
    expect(res.body.status).to.equal(400);
  });

  test("Error field should indicate Bad Request", function() {
    expect(res.body.error).to.equal('Bad Request');
  });

  test("Message should mention invalid or unknown type", function() {
    expect(res.body.message).to.include('unknown type');
  });
}
