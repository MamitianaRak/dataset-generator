meta {
  name: Create Entity - User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/entities
  body: json
  auth: none
}

body:json {
  {
    "name": "User",
    "quantity": 100,
    "attributes": [
      {
        "name": "id",
        "type": {
          "typeClass": "IntegerType"
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "SequentialGenerator",
          "start": 1,
          "step": 1
        }
      },
      {
        "name": "age",
        "type": {
          "typeClass": "IntegerType"
        },
        "constraints": [
          {
            "constraintClass": "MinMaxConstraint",
            "min": 18,
            "max": 65
          }
        ],
        "quantity": 1,
        "generator": {
          "generatorClass": "RandomGenerator"
        }
      },
      {
        "name": "email",
        "type": {
          "typeClass": "StringType",
          "maxLength": 100
        },
        "constraints": [],
        "quantity": 1,
        "generator": {
          "generatorClass": "EmailGenerator"
        }
      }
    ],
    "subEntities": []
  }
}

vars:pre-request {
  projectId: 1
}

tests {
  test("Status code should be 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Response should contain entity ID", function() {
    expect(res.body).to.have.property('id');
    expect(res.body.id).to.be.a('number');
  });

  test("Response should contain entity name", function() {
    expect(res.body).to.have.property('name');
    expect(res.body.name).to.equal('User');
  });

  test("Response should contain attributes", function() {
    expect(res.body).to.have.property('attributes');
    expect(res.body.attributes).to.be.an('array');
    expect(res.body.attributes.length).to.be.greaterThan(0);
  });

  test("Entity quantity should match", function() {
    expect(res.body.quantity).to.equal(100);
  });
}
