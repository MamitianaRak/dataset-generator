meta {
  name: 05 - Preview Data
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/projects/{{current_project_id}}/preview?count=5
  body: none
  auth: none
}

tests {
  test("Status code should be 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response should be an object", function() {
    expect(res.body).to.be.an('object');
  });

  test("Response should contain project information", function() {
    expect(res.body).to.have.property('projectId');
    expect(res.body).to.have.property('projectName');
  });

  test("Response should contain generated data", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });

  test("Should have data for 2 entities", function() {
    expect(res.body.data.length).to.equal(2);
  });

  test("Each entity should have entityName and records", function() {
    const entity = res.body.data[0];
    expect(entity).to.have.property('entityName');
    expect(entity).to.have.property('records');
    expect(entity.records).to.be.an('array');
  });

  test("Records should contain at least 5 items each", function() {
    res.body.data.forEach(entity => {
      expect(entity.records.length).to.be.at.least(5);
    });
  });
}
