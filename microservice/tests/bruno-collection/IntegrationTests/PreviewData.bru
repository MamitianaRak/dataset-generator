meta {
  name: 4 - Preview Data
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/projects/{{current_project_id}}/preview
  body: none
  auth: none
}

tests {
  test("Status code should be 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response should contain project ID", function() {
    expect(res.body).to.have.property('projectId');
  });

  test("Response should contain project name", function() {
    expect(res.body).to.have.property('projectName');
    expect(res.body.projectName).to.include('Integration Test Project');
  });

  test("Response should contain generated data array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });

  test("Data should contain entity with records", function() {
    expect(res.body.data.length).to.be.greaterThan(0);
    expect(res.body.data[0]).to.have.property('entityName');
    expect(res.body.data[0]).to.have.property('records');
    expect(res.body.data[0].records).to.be.an('array');
  });

  test("Entity should have 25 records (updated quantity)", function() {
    expect(res.body.data[0].records.length).to.equal(25);
  });

  test("Records should have the expected attributes", function() {
    if (res.body.data[0].records.length > 0) {
      var firstRecord = res.body.data[0].records[0];
      // Check if record has fields property (nested structure)
      if (firstRecord.fields) {
        expect(firstRecord.fields).to.have.property('id');
        expect(firstRecord.fields).to.have.property('fullName');
        expect(firstRecord.fields).to.have.property('age');
        expect(firstRecord.fields).to.have.property('email');
        expect(firstRecord.fields).to.have.property('isActive');
      } else {
        // Flat structure
        expect(firstRecord).to.have.property('id');
        expect(firstRecord).to.have.property('fullName');
        expect(firstRecord).to.have.property('age');
        expect(firstRecord).to.have.property('email');
        expect(firstRecord).to.have.property('isActive');
      }
    }
  });
}
