meta {
  name: 8 - Get Entity
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/entities/{{unit_entity_id}}
  body: none
  auth: none
}

tests {
  test("Status code should be 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response should contain entity details", function() {
    expect(res.body).to.have.property('id');
    expect(res.body).to.have.property('name');
    expect(res.body).to.have.property('quantity');
    expect(res.body).to.have.property('attributes');
  });

  test("Entity ID should be a number", function() {
    expect(res.body.id).to.be.a('number');
  });

  test("Attributes should be an array", function() {
    expect(res.body.attributes).to.be.an('array');
  });
}
