meta {
  name: 400 - Create Entity Unknown Type
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/entities
  body: json
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8081/api
  projectId: 1
}

body:json {
  {
    "name": "EntityWithUnknownType",
    "quantity": 10,
    "attributes": [
      {
        "name": "unknownField",
        "quantity": 1,
        "type": {
          "type": "UnknownType"
        },
        "constraints": [],
        "generator": {
          "type": "FakerGenerator"
        }
      }
    ]
  }
}

tests {
  test("Status code should be 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Response should indicate unknown type error", function() {
    expect(res.body).to.be.an('object');
  });

  test("Should reject unknown field type", function() {
    expect(res.status).to.not.equal(201);
  });
}
