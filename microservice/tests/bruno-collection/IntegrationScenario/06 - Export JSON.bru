meta {
  name: 06 - Export JSON
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/projects/{{current_project_id}}/export?format=json&count=10
  body: none
  auth: none
}

tests {
  test("Status code should be 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Content-Type should be application/json", function() {
    expect(res.headers['content-type']).to.include('application/json');
  });

  test("Response should be valid JSON", function() {
    expect(res.body).to.be.an('object');
  });

  test("Response should contain User and Product", function() {
    expect(res.body).to.have.property('User');
    expect(res.body).to.have.property('Product');
  });
}
