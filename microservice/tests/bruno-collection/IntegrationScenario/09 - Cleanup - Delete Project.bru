meta {
  name: 09 - Cleanup - Delete Project
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/projects/{{current_project_id}}
  body: none
  auth: none
}

tests {
  test("Status code should be 204 or 200", function() {
    expect([200, 204]).to.include(res.status);
  });

  test("Project should be deleted successfully", function() {
    // No error means successful deletion
    expect(res.status).to.be.lessThan(300);
  });
}

