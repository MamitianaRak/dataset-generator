meta {
  name: 1 - List Projects
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/projects
  body: none
  auth: none
}

tests {
  test("Status code should be 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response should be an array", function() {
    expect(res.body).to.be.an('array');
  });

  test("Array items should have required fields", function() {
    if (res.body.length > 0) {
      expect(res.body[0]).to.have.property('id');
      expect(res.body[0]).to.have.property('name');
      expect(res.body[0]).to.have.property('dateCreated');
    }
  });
}
