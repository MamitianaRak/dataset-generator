meta {
  name: Export JSON
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/projects/{{projectId}}/export?format=json
  body: none
  auth: none
}

vars:pre-request {
  projectId: 1
}

tests {
  test("Status code should be 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Content-Type should be application/json", function() {
    expect(res.headers['content-type']).to.include('application/json');
  });

  test("Response should contain exported data", function() {
    expect(res.body).to.exist;
  });
}
