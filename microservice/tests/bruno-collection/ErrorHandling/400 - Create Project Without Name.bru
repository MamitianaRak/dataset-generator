meta {
  name: 400 - Create Project Without Name
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8081/api
}

body:json {
  {
    "name": ""
  }
}

tests {
  test("Status code should be 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Response should indicate validation error", function() {
    expect(res.body).to.be.an('object');
  });
}
