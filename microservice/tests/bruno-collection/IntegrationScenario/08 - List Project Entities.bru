meta {
  name: 08 - List Project Entities
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/projects/{{current_project_id}}/entities
  body: none
  auth: none
}

tests {
  test("Status code should be 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response should be an array", function() {
    expect(res.body).to.be.an('array');
  });

  test("Should have 2 entities (User and Product)", function() {
    expect(res.body.length).to.equal(2);
  });

  test("Should contain User entity", function() {
    const userEntity = res.body.find(e => e.name === 'User');
    expect(userEntity).to.not.be.undefined;
  });

  test("Should contain Product entity", function() {
    const productEntity = res.body.find(e => e.name === 'Product');
    expect(productEntity).to.not.be.undefined;
  });
}
