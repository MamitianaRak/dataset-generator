meta {
  name: Delete Project
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/projects/{{projectId}}
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8081/api
  projectId: 1
}

tests {
  test("Status code should be 204 or 200", function() {
    expect([200, 204]).to.include(res.status);
  });

  test("Should successfully delete the project", function() {
    expect(res.status).to.not.equal(404);
    expect(res.status).to.not.equal(500);
  });
}
